# -----------------------------------------------------------------------------
# LegalITA LLM backend
# -----------------------------------------------------------------------------
# native  -> first-party Anthropic/OpenAI APIs (backward-compatible default)
# bedrock -> Amazon Bedrock for Anthropic/OpenAI models mapped by LegalITA
LLM_BACKEND=native

# -----------------------------------------------------------------------------
# Native provider credentials (used only when LLM_BACKEND=native)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional providers already supported by LegalITA
GOOGLE_API_KEY=
NOVITA_API_KEY=

# -----------------------------------------------------------------------------
# Amazon Bedrock (used only when LLM_BACKEND=bedrock)
# -----------------------------------------------------------------------------
# Generate an Amazon Bedrock API key and place it here. Do not reuse a native
# Anthropic/OpenAI API key.
AWS_BEARER_TOKEN_BEDROCK=

# Region used by both Bedrock Runtime (Claude) and Bedrock Mantle (OpenAI).
# us-east-2 is a practical default for the bundled gpt-5.5 mapping; verify model
# availability and data-residency requirements for your AWS account.
BEDROCK_REGION=us-east-2

# Anthropic inference profile prefix. Supported by this integration:
# global | us | eu | au | jp
BEDROCK_ANTHROPIC_SCOPE=us

# Optional override. Normally leave unset; LegalITA derives:
# https://bedrock-mantle.<region>.api.aws/openai/v1
# BEDROCK_OPENAI_BASE_URL=

# -----------------------------------------------------------------------------
# Default adaptive 2-of-3 judges
# -----------------------------------------------------------------------------
JUDGE_STRATEGY=adaptive_majority
JUDGE_A_PROVIDER=anthropic
JUDGE_A_MODEL=claude-sonnet-4-6
JUDGE_B_PROVIDER=openai
JUDGE_B_MODEL=gpt-5.5
JUDGE_C_PROVIDER=anthropic
JUDGE_C_MODEL=claude-opus-4-8
